# Copy to .env.local and fill in as each phase needs it.
# The app boots with every one of these blank - see SETUP.md.

# ---- Phase 0 ----------------------------------------------------------------
# IANA timezone. Everything is stored UTC and rendered in this zone.
DEFAULT_TIMEZONE=America/Chicago

# Display name of the calendar the app creates and writes its blocks to.
PLANNER_CALENDAR_NAME=Planner

# ---- Phase 1: Supabase ------------------------------------------------------
# While both are blank the app runs in preview mode: real UI, no login,
# on-disk settings. Preview mode is disabled in production builds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed if magic-link emails build the wrong redirect URL (e.g. behind a
# proxy). Otherwise the request's own origin is used.
NEXT_PUBLIC_SITE_URL=

# ---- Phase 2: iCloud CalDAV -------------------------------------------------
# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the Apple app-specific password at rest. Changing it makes any
# stored credential unreadable - you'd have to reconnect iCloud.
APP_ENCRYPTION_KEY=

# ---- Phase 3: LLM provider --------------------------------------------------
# "groq" (free tier, good enough to prove the flow) or "anthropic".
# Switching providers is these two lines plus the matching key - no code change.
LLM_PROVIDER=groq

# gpt-oss-120b, not llama-3.3-70b: llama intermittently fails to emit a tool
# call against this tool set. Verify any replacement with `npm run check:llm`.
LLM_MODEL=openai/gpt-oss-120b

# Free, no card: https://console.groq.com -> API Keys
GROQ_API_KEY=

# Only needed once LLM_PROVIDER=anthropic (then set LLM_MODEL=claude-sonnet-5)
ANTHROPIC_API_KEY=
